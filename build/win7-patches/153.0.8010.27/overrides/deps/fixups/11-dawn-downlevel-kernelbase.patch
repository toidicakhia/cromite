@@ -44,6 +44,11 @@ bool IsSameHandle(DeviceBase* device, HANDLE handle, HANDLE other) {
     }
 
     auto deviceD3D11 = ToBackend(device);
+    if (deviceD3D11->GetFunctionsBase()->compareObjectHandles == nullptr) {
+        // CompareObjectHandles is unavailable (e.g. on Windows 7/8); the
