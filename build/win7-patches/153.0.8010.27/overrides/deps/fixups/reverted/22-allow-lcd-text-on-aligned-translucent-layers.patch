--- a/cc/layers/picture_layer_impl.cc
+++ b/cc/layers/picture_layer_impl.cc
@@ -726,9 +726,10 @@ LCDTextDisallowedReason PictureLayerImpl::ComputeLCDTextDisallowedReason(
   // "will-change: transform" containers (YouTube sidebars/thumbnail grids,
   // Facebook dialogs at rest, extension bubbles), which otherwise falls back
   // to blurry grayscale AA. Layers that can actually be resampled (running
-  // transform animations, filters, non-opaque contents) keep the stock
-  // grayscale rules; a layer with pending will-change/fractional offsets only
-  // gets LCD text if its raster translation is pixel-aligned as well.
+  // transform animations, fractional offsets, filters on non-aligned layers)
+  // keep the stock grayscale rules; a layer with pending will-change/
+  // fractional offsets only gets LCD text if its raster translation is
+  // pixel-aligned as well.
   if (screen_space_transform_is_animating()) {
     return LCDTextDisallowedReason::kTransformAnimation;
   }
@@ -755,12 +756,12 @@ LCDTextDisallowedReason PictureLayerImpl::ComputeLCDTextDisallowedReason(
     return LCDTextDisallowedReason::kNonIntegralTranslation;
   }
 
-  if (!contents_opaque_for_text()) {
-    if (!background_color().isOpaque()) {
-      return LCDTextDisallowedReason::kBackgroundColorNotOpaque;
-    }
-    return LCDTextDisallowedReason::kContentsNotOpaque;
-  }
+  // [WIN7] Aligned layers are composited 1:1, so per-subpixel glyph blending
